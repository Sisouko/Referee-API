erDiagram
    ARBITRE ||--o{ AFFECTATION : "possède"
    MATCH ||--o{ AFFECTATION : "possède"

    ARBITRE {
        integer id PK
        string nom
        string prenom
        string nationalite
        enum confederation
        enum categorie
        integer experience
        enum statut
