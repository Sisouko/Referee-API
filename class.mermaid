    MATCH {
        integer id PK
        string equipeDomicile
        string equipeExterieur
        string stade
        string villeHote
        date dateMatch
        enum phase
    }

    AFFECTATION {
        integer id PK
        integer arbitreId FK
        integer matchId FK
        enum role
    }